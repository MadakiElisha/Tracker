<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tracker_world">

    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material>
            <ambient>0.4 0.5 0.3 1</ambient>
            <diffuse>0.4 0.5 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall">
      <static>true</static>
      <pose>5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 8 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 8 3</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Realistic targets from Gazebo Fuel (CC0). First load downloads ~100 MB; run sim/fetch_models.sh first. =====
         Names below are moved by sim/move_target.py. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking%20person</uri>
      <name>moving_target</name>
      <static>true</static>
      <pose>20 0 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual%20female</uri>
      <name>moving_person2</name>
      <static>true</static>
      <pose>15 8 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>vehicle_target</name>
      <static>true</static>
      <pose>0 -15 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <name>moving_suv</name>
      <static>true</static>
      <pose>-10 15 0 0 0 0.0</pose>
    </include>
    <!-- ===== Static scene (never moved) ===== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <name>parked_hatchback_0</name>
      <static>true</static>
      <pose>25 -6 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <name>parked_hatchback_1</name>
      <static>true</static>
      <pose>25 -9 0 0 0 1.57</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bus</uri>
      <name>parked_bus_2</name>
      <static>true</static>
      <pose>30 -25 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <name>parked_suv_3</name>
      <static>true</static>
      <pose>12 -22 0 0 0 0.3</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person</uri>
      <name>standing_person_0</name>
      <static>true</static>
      <pose>15 6 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person</uri>
      <name>standing_person_1</name>
      <static>true</static>
      <pose>16 7 0 0 0 0.5</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person</uri>
      <name>standing_person_2</name>
      <static>true</static>
      <pose>14 -4 0 0 0 1.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing%20person</uri>
      <name>standing_person_3</name>
      <static>true</static>
      <pose>28 10 0 0 0 1.5</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction%20Cone</uri>
      <name>cone_0</name>
      <static>true</static>
      <pose>18.0 -3 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction%20Cone</uri>
      <name>cone_1</name>
      <static>true</static>
      <pose>19.5 -3 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction%20Cone</uri>
      <name>cone_2</name>
      <static>true</static>
      <pose>21.0 -3 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction%20Cone</uri>
      <name>cone_3</name>
      <static>true</static>
      <pose>22.5 -3 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction%20Cone</uri>
      <name>cone_4</name>
      <static>true</static>
      <pose>24.0 -3 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction%20Cone</uri>
      <name>cone_5</name>
      <static>true</static>
      <pose>25.5 -3 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>tree_0</name>
      <static>true</static>
      <pose>35 15 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>tree_1</name>
      <static>true</static>
      <pose>35 -15 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>tree_2</name>
      <static>true</static>
      <pose>10 25 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>tree_3</name>
      <static>true</static>
      <pose>-5 -25 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>tree_4</name>
      <static>true</static>
      <pose>40 0 0 0 0 0.0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak%20tree</uri>
      <name>tree_5</name>
      <static>true</static>
      <pose>22 22 0 0 0 0.0</pose>
    </include>

    <include>
      <uri>model://iris_with_ardupilot</uri>
      <pose>0 0 0.195 0 0 0</pose>
    </include>

  </world>
</sdf>
